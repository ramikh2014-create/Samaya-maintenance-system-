# Copy this file to .env and fill in your real values. Never commit .env.

# Your Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://bjbaheznhdkzyidhwbsc.supabase.co

# Your Supabase SERVICE ROLE key (Project Settings -> API -> service_role secret).
# This key bypasses Row Level Security, so it must ONLY ever live on the backend server,
# never in frontend code or a public repo.
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# Port the backend API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Use * only for local testing.
CORS_ORIGIN=*
